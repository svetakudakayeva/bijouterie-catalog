# Скопируйте в .env и заполните реальными значениями.
# .env НИКОГДА не коммитится (см. .gitignore).

# Локально с Docker: docker compose up -d
# Локально без Docker (облачный Postgres, например Neon):
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bijouterie?schema=public"

# Публичный базовый URL (используется в e2e и метаданных)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Загрузка изображений (Cloudinary) - заполните позже
CLOUDINARY_URL=""

# Мониторинг ошибок (Sentry) - заполните позже
SENTRY_DSN=""
